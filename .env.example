# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Web Push (Story 1.11) ---
# Public VAPID key — must match VAPID_PUBLIC_KEY in chopnow-api .env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_me_with_chopnow_api_vapid_public_key

# --- Optional: Mapbox orientation map on /livreur/courses/[id] (Story 4.4) ---
# When unset, the rider sees only the "Ouvrir dans Maps" deep-link button.
# Get a public token at https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Optional analytics / observability ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (Story O1) ---
# Public DSN — clients use this to authenticate to Sentry's ingest.
# Leave empty in dev; set in Vercel prod + preview env to enable.
# Inert when unset (zero beacons, zero overhead).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — used by withSentryConfig to upload source maps to
# Sentry on prod builds. CI sets it via the SENTRY_AUTH_TOKEN repo
# secret. Without it the build skips source-map upload gracefully.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
